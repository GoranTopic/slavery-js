# syntax=docker/dockerfile:1.4
#
# Template Dockerfile for the Worker container of a project that uses slavery-js.
# Build context must be your project root:
#
#   docker build -f examples/kubernetes/Dockerfile.worker -t my-app-worker .
#
# ── Stage 1: install all deps ─────────────────────────────────────────────────
FROM node:22-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci

# ── Stage 2: compile TypeScript ───────────────────────────────────────────────
FROM deps AS builder
COPY tsconfig.json tsup.config.ts ./
COPY src/ ./src/
RUN npm run build

# ── Stage 3: install production deps only ─────────────────────────────────────
FROM node:22-slim AS prod-deps
WORKDIR /app
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# ── Stage 4: distroless runtime ───────────────────────────────────────────────
FROM gcr.io/distroless/nodejs22-debian12 AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder   /app/dist         ./dist

# distroless runs as nonroot (uid 65532) by default
EXPOSE 3001

CMD ["--enable-source-maps", "dist/distributed/worker-process.js"]
